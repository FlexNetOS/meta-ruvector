{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" post-edit'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" post-bash'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" compact-manual'",
            "type": "command"
          },
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" session-end'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "manual"
      },
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" compact-auto'",
            "type": "command"
          },
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" session-end'",
            "timeout": 6,
            "type": "command"
          }
        ],
        "matcher": "auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" pre-bash'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" pre-edit'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" session-restore'",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/auto-memory-hook.mjs\" import'",
            "timeout": 8,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"./.claude/helpers/run-rtk-command.sh\" sh -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec rusty-idd next --base \"$root\"'",
            "statusMessage": "Rusty IDD front door: computing the next step",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" session-end'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/auto-memory-hook.mjs\" sync'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" status'",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" post-task'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "rtk run 'node \"$(git rev-parse --show-toplevel)/.claude/helpers/hook-handler.cjs\" route'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
